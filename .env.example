# Copy to .env with:  python -m src.check_env --init   then fill in the secrets below.
# .env is gitignored. Never commit it, paste it into chats/issues, or share it in screenshots.

# Groq: each person uses their own free key (also multiplies the rate limit).
#   https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face: a READ-ONLY token. Optional, but raises Hub rate limits during ingestion.
#   https://huggingface.co/settings/tokens
HF_TOKEN=

# Pinecone: one shared key, created by whoever owns the index (role B). Share it privately.
# Everyone else writes only to their own exp-<name> namespace (config.yaml: pinecone.namespace).
#   https://app.pinecone.io
PINECONE_API_KEY=

# groq | ollama  (D7: switching provider is this one setting)
LLM_PROVIDER=groq
OLLAMA_HOST=http://localhost:11434

# Optional overrides. Models are pinned in config.yaml (llm.*); set these only to test another model.
GROQ_MODEL=
OLLAMA_MODEL=

# Windows only: make Python use UTF-8 everywhere (Devanagari model cards).
# PYTHONUTF8=1
